# Copy to backend/.env and fill in. Never commit .env.
OAG_API_KEY=
# false (default): serve saved fixtures only, never call OAG.
# true: a fixture miss makes one live OAG call and saves the response as a fixture.
OAG_LIVE=false
# Story AI. Empty provider = pre-written story only. "openai" = the openai SDK:
# OpenAI itself (leave LLM_BASE_URL empty) or an OpenAI-compatible provider such as Gemini
# (set LLM_BASE_URL to its OpenAI-compatible endpoint). LLM_MODEL is required, never guessed.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# false (default): serve reviewed story fixtures or the pre-written story, never call the AI on a request.
# true: a trip with no story fixture makes one live AI call (safety-checked, falls back on any failure).
LLM_LIVE=false
LLM_TIMEOUT_SECONDS=30
# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:5173
